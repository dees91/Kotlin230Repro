BEGIN TRANSACTION;

DROP VIEW IF EXISTS view38;

CREATE VIEW IF NOT EXISTS view38 AS
    SELECT
        I.id,
        I.col101,
        I.col103,
        I.col26,
        I.col62,
        I.col152,
        T.col69 AS col171,
        S.col101 AS col206,
        S.col103 AS col208,
        C.col272,
        IE.col21,
        P.col36,
        P.col28 AS col203,
        P.col65,
        MC.col87 AS col231,
        P.col158,
        C.col87 AS col267
    FROM table5 I
    INNER JOIN table10 T ON I.col172=T.id
    INNER JOIN table19 S ON I.col24=S.id
    LEFT JOIN view6 C ON I.id=C.col15
    LEFT JOIN table8 IE ON I.id = IE.col15
    LEFT JOIN table12 P ON P.id = IE.col21
    LEFT JOIN table57 C ON P.col158=C.id
    LEFT JOIN table36 MC ON P.col65=MC.id
    WHERE T.col69 = 'VAL15';

COMMIT;
