BEGIN TRANSACTION;

    DROP VIEW IF EXISTS view33;

    CREATE VIEW IF NOT EXISTS view33 AS
        SELECT id,
            col40,
            col97,
            col123,
            (CASE WHEN JSON_VALID(col20)
                THEN
                    (CASE
                        WHEN JSON_EXTRACT(col20, '$.data.col103') THEN JSON_EXTRACT(col20, '$.data.col103')
                        WHEN JSON_EXTRACT(col20, '$.col195') THEN JSON_EXTRACT(col20, '$.col195')
                        WHEN col97 = 'VAL273' THEN 999991
                        WHEN col97 = 'VAL191' THEN 999992
                        ELSE 999990
                    END )
                ELSE
                    NULL
                END
            ) AS col103,
            col20,
            col142,
            col138
        FROM table45
        WHERE (col97 = 'VAL32'
            OR col97 = 'VAL31'
            OR col97 = 'VAL221'
            OR col97 = 'VAL273'
            OR col97 = 'VAL232'
            OR col97 = 'VAL191');

    DROP VIEW IF EXISTS view38;

    CREATE VIEW IF NOT EXISTS view38 AS
        SELECT
            IR.col15 AS id,
            I.col101,
            I.col103,
            I.col26,
            I.col62,
            I.col152,
            T.col69 AS col171,
            S.col101 AS col206,
            S.col103 AS col208,
            IR.col124,
            IR.col21,
            P.col36,
            P.col28 AS col203,
            P.col65,
            MC.col87 AS col231,
            P.col158,
            C.col87 AS col267
        FROM table6 IR
        INNER JOIN table5 I ON IR.col15 = I.id
        INNER JOIN table10 T ON I.col172 = T.id
        INNER JOIN table19 S ON I.col24 = S.id
        LEFT JOIN table12 P ON P.id = IR.col21
        LEFT JOIN table57 C ON P.col158 = C.id
        LEFT JOIN table36 MC ON P.col65 = MC.id
        WHERE T.col69 = 'VAL15';

COMMIT;
