import pl.deesoft.kotlinrepro.db.Type7;
import pl.deesoft.kotlinrepro.db.Type11;
import java.time.ZonedDateTime;

BEGIN TRANSACTION;

    CREATE TABLE table33(
        id TEXT NOT NULL,
        col24 TEXT NOT NULL,
        col66 TEXT AS Type6 NOT NULL,
        PRIMARY KEY (id, col24)
    );

    CREATE INDEX idx69 ON table33(id);
    CREATE INDEX idx68 ON table33(col24);

    INSERT INTO table33(id, col24, col66)
        SELECT id, col24, 'VAL9' AS col66
        FROM table27;

    DROP VIEW IF EXISTS view22;

    DROP INDEX IF EXISTS idx60;
    DROP INDEX IF EXISTS idx58;
    DROP INDEX IF EXISTS idx61;
    DROP INDEX IF EXISTS idx59;

    DROP INDEX IF EXISTS idx52;
    DROP INDEX IF EXISTS idx55;
    DROP INDEX IF EXISTS idx53;
    DROP INDEX IF EXISTS idx56;
    DROP INDEX IF EXISTS idx54;

    CREATE TABLE table31(
        col120 TEXT NOT NULL,
        col55 TEXT NOT NULL,
        col24 TEXT NOT NULL,
        col21 TEXT NOT NULL,
        col61 TEXT AS Type8 NOT NULL,
        col42 TEXT NOT NULL,
        PRIMARY KEY (col55, col24, col21, col42)
    );

    CREATE INDEX idx60 ON table31(col55);
    CREATE INDEX idx58 ON table31(col24);
    CREATE INDEX idx61 ON table31(col61);
    CREATE INDEX idx59 ON table31(col42);

    CREATE TABLE table30(
        col9 INTEGER NOT NULL,
        col55 TEXT NOT NULL,
        col24 TEXT NOT NULL,
        col61 TEXT AS Type8 NOT NULL,
        col42 TEXT NOT NULL,
        col151 TEXT AS ZonedDateTime DEFAULT NULL,
        col63 TEXT AS ZonedDateTime DEFAULT NULL,
        PRIMARY KEY (col55, col24, col61, col42, col9)
    );

    CREATE INDEX idx52 ON table30(col9);
    CREATE INDEX idx55 ON table30(col55);
    CREATE INDEX idx53 ON table30(col24);
    CREATE INDEX idx56 ON table30(col61);
    CREATE INDEX idx54 ON table30(col42);

    INSERT INTO table31(col120, col55, col24, col21, col61, col42)
        SELECT '' AS col120, col55, col24, col21, col119, col42
        FROM table28;

    DROP TABLE table28;

    ALTER TABLE table31 RENAME TO table28;

    INSERT INTO table30(col9, col55, col24, col61, col42, col151, col63)
        SELECT col9, col55, col24, col119, col42, col151, col63
        FROM table29;

    DROP TABLE table29;

    ALTER TABLE table30 RENAME TO table29;

    CREATE VIEW IF NOT EXISTS view22 AS
    WITH localStatuses AS (
        SELECT
            col55,
            col24,
            CASE
                WHEN COUNT(DISTINCT AreaStatus) = 1 AND SUM(CASE WHEN AreaStatus = 'VAL203' THEN 1 ELSE 0 END) > 0 THEN 'VAL203'
                WHEN SUM(CASE WHEN AreaStatus = 'VAL231' OR AreaStatus = 'VAL203' THEN 1 ELSE 0 END) > 0 THEN 'VAL231'
                ELSE 'VAL184'
            END AS col241
        FROM
            (
              SELECT
                    pc.id AS col55,
                    pc.col24,
                    CASE
                        WHEN pcpa.col151 IS NOT NULL AND pcpa.col63 IS NULL THEN 'VAL231'
                        WHEN pcpa.col151 IS NOT NULL AND pcpa.col63 IS NOT NULL THEN 'VAL203'
                        ELSE 'VAL184'
                    END AS AreaStatus
                FROM
                    table27 pc
                LEFT JOIN
                    table29 pcpa ON pc.id = pcpa.col55 AND pc.col24 = pcpa.col24
            ) AS col191
        GROUP BY
            col55, col24
    )
    SELECT
        pc.id,
        pc.col101,
        pc.col24,
        pc.col176,
        pc.col154 AS col258,
        ls.col241,
        CASE
            WHEN pc.col154 IN ('VAL262', 'VAL90') THEN pc.col154
            ELSE ls.col241
        END AS col212
    FROM
        table27 pc
    INNER JOIN localStatuses ls ON pc.id = ls.col55 AND pc.col24 = ls.col24
    ORDER BY
        pc.col176 DESC, pc.id DESC;

COMMIT;