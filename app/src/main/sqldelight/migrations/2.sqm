BEGIN TRANSACTION;

    DROP INDEX IF EXISTS idx82;

    DROP TABLE IF EXISTS  table37;

    CREATE TABLE table37(
        id TEXT NOT NULL PRIMARY KEY DEFAULT (uuid()),
        col86 TEXT NOT NULL,
        col38 TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%f', 'now')),
        col121 INTEGER NOT NULL DEFAULT 0,
        col114 TEXT DEFAULT NULL,
        col11 INTEGER NOT NULL DEFAULT 0,
        col133 INTEGER DEFAULT NULL,
        col10 TEXT DEFAULT NULL
    );

    CREATE UNIQUE INDEX idx82 ON table37(id);
    CREATE INDEX idx81 ON table37(col38,col121);
    CREATE INDEX idx80 ON table37(col10);
    CREATE INDEX idx83 ON table37(col133);

COMMIT;
