BEGIN TRANSACTION;

    ALTER TABLE table14 ADD COLUMN col1 TEXT NOT NULL DEFAULT "";

    CREATE TABLE IF NOT EXISTS table17 (
        id INTEGER NOT NULL PRIMARY KEY,
        col21 TEXT NOT NULL,
        col159 TEXT NOT NULL,
        col7 INTEGER AS Boolean NOT NULL,
        CONSTRAINT cstr4 FOREIGN KEY (col21) REFERENCES table12(id) ON DELETE CASCADE ON UPDATE CASCADE,
        CONSTRAINT cstr23 FOREIGN KEY (col159) REFERENCES table12(id) ON DELETE CASCADE ON UPDATE CASCADE
    );

    CREATE INDEX IF NOT EXISTS idx25 ON table17(col21);
    CREATE INDEX IF NOT EXISTS idx27 ON table17(col159);

COMMIT;
