BEGIN TRANSACTION;

    PRAGMA foreign_keys=off;

    DROP INDEX IF EXISTS idx3;
    DROP INDEX IF EXISTS idx10;
    DROP INDEX IF EXISTS idx5;
    DROP INDEX IF EXISTS idx1;
    DROP INDEX IF EXISTS idx4;
    DROP INDEX IF EXISTS idx8;
    DROP INDEX IF EXISTS idx2;

    CREATE TABLE table7(
        id TEXT NOT NULL PRIMARY KEY DEFAULT (uuid()),
        col166 TEXT NOT NULL DEFAULT (uuid()),
        col15 TEXT NOT NULL,
        col21 TEXT NOT NULL,
        col158 TEXT NOT NULL,
        col65 TEXT NOT NULL,
        col28 INTEGER NOT NULL,
        col83 TEXT DEFAULT NULL,
        col136 TEXT NOT NULL,
        col137 TEXT NOT NULL DEFAULT "VAL286",
        col124 INTEGER NOT NULL DEFAULT 1,
        col164 TEXT DEFAULT NULL,
        col108 INTEGER NOT NULL DEFAULT 0,
        col91 TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%f', 'now')),
        UNIQUE (col15, col166),
        CONSTRAINT cstr2
            FOREIGN KEY (col15)
            REFERENCES table5(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr4
            FOREIGN KEY (col21)
            REFERENCES table12(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr22
            FOREIGN KEY (col158)
            REFERENCES table57(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr11
            FOREIGN KEY (col65)
            REFERENCES table36(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION
    );

    CREATE UNIQUE INDEX idx3 ON table7(id);
    CREATE UNIQUE INDEX idx10 ON table7(col15,col166);
    CREATE INDEX idx5 ON table7(col83);
    CREATE INDEX idx1 ON table7(col28);
    CREATE INDEX idx4 ON table7(col21,col158,col65);
    CREATE INDEX idx8 ON table7(col164);
    CREATE INDEX idx2 ON table7(col91);

    INSERT INTO table7(id,col15,col166,col21,col158,col65,col28,col83,col136,col137,col124,col91,col108)
    SELECT id,col15,col166,col21,col158,col65,col28,col83,col136,col137,col124,col38,-1
    FROM table6;

    DROP TABLE table6;

    ALTER TABLE table7 RENAME TO table6;

    PRAGMA foreign_keys=on;

COMMIT;
