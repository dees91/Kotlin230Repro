PRAGMA foreign_keys=off;
BEGIN TRANSACTION;

ALTER TABLE table19 ADD col162 TEXT DEFAULT NULL;

CREATE TABLE table58 (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    col24 TEXT NOT NULL,
    col162 TEXT DEFAULT NULL,
    CONSTRAINT cstr7
                    FOREIGN KEY (col24)
                    REFERENCES table19(id)
                    ON DELETE CASCADE
                    ON UPDATE NO ACTION,
    CONSTRAINT cstr25
                    FOREIGN KEY (col162)
                    REFERENCES table41(id)
                    ON DELETE CASCADE
                    ON UPDATE NO ACTION
);

DROP VIEW IF EXISTS view26;
DROP VIEW IF EXISTS view5;

CREATE VIEW IF NOT EXISTS view26 AS
    SELECT
       S.id,
       S.col88,
       S.col103,
       S.col101,
       S.col30,
       ES.col7,
       ES.col160,
       S.col162,
       col189.col162 AS col269,
       ES.col150,
       ES.col123,
       ES.col78
    FROM
        table19 S
    JOIN table54 ES ON S.id=ES.col24
    LEFT JOIN table58 col189 ON col189.col24=S.id;

CREATE VIEW view5 AS
    SELECT
        S.id AS col24,
        S.col160 AS col160,
        S.col162,
        S.col269,
        S.col101 AS col101,
        S.col103 AS col103,
        S.col123 AS col123,
        S.col150 AS col150,
        S.col78 AS col78,
        S.col30 AS col30,
        (SELECT COALESCE(COUNT(I.id), 0) FROM table5 I WHERE I.col24=S.id AND I.col155 IN ('VAL121', 'VAL201', 'VAL122', 'VAL68', 'VAL1', 'VAL14', 'VAL17')) AS col194,
        (SELECT TOTAL(EC.table23) FROM table24 EC WHERE EC.col24=S.id) AS col222
    FROM view26 S
    WHERE col7 = 1
    ORDER BY S.col160 ASC, S.col103 ASC, col222 DESC;

PRAGMA foreign_keys=on;

COMMIT;
