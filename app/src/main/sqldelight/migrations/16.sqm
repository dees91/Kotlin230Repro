import kotlin.Boolean;

BEGIN TRANSACTION;

    PRAGMA foreign_keys=off;

    DROP VIEW IF EXISTS view25;

    DROP INDEX IF EXISTS idx95;
    DROP INDEX IF EXISTS idx100;
    DROP INDEX IF EXISTS idx99;
    DROP INDEX IF EXISTS idx96;

    CREATE TABLE table52(
        id TEXT NOT NULL PRIMARY KEY,
        col127 TEXT DEFAULT NULL,
        col140 TEXT NOT NULL,
        col128 TEXT NOT NULL,
        col71 TEXT DEFAULT NULL,
        col178 TEXT AS ZonedDateTime NOT NULL,
        col141 TEXT DEFAULT NULL,
        col129 TEXT DEFAULT NULL,
        col72 TEXT DEFAULT NULL,
        col147 TEXT NOT NULL,
        col113 TEXT NOT NULL,
        col29 INTEGER AS Boolean NOT NULL,
        col2 TEXT AS Type1 DEFAULT NULL,
        col132 TEXT AS Type1 DEFAULT NULL,
        col70 TEXT AS ZonedDateTime DEFAULT NULL,
        col104 INTEGER DEFAULT NULL,
        col34 TEXT DEFAULT NULL,
        CONSTRAINT cstr17
            FOREIGN KEY (col140)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr16
            FOREIGN KEY (col128)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr15
            FOREIGN KEY (col71)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION
    );

    CREATE INDEX idx95 ON table52(id);
    CREATE INDEX idx100 ON table52(col140);
    CREATE INDEX idx99 ON table52(col128);
    CREATE INDEX idx96 ON table52(col71);

    INSERT INTO table52(id, col127, col140, col128, col71, col178, col141, col129, col72, col147, col113, col29, col2, col132, col70, col104, col34)
        SELECT id, col127, col140, col128, col71, col178, col141, col129, col72, col147, col113, col29, col2, col132, col70, NULL, NULL
        FROM table49;

    DROP TABLE table49;

    ALTER TABLE table52 RENAME TO table49;

    CREATE VIEW view25 AS
        SELECT
            D.id,
            D.col127,
            D.col178,
            D.col147,
            D.col113,
            D.col29,
            D.col2,
            D.col132,
            S.id AS col262,
            S.col101 AS col263,
            S.col103 AS col264,
            S.col171 AS col265,
            D.col141,
            R.id AS col253,
            R.col101 AS col254,
            R.col103 AS col255,
            R.col171 AS col256,
            D.col129,
            I.col101 AS col236,
            I.col103 AS col237,
            I.col171 AS col238,
            D.col72,
            D.col70,
            D.col104,
            D.col34
        FROM
            table49 D
        JOIN table41 S ON S.id=D.col140
        JOIN table41 R ON R.id=D.col128
        LEFT JOIN table41 I ON I.id=D.col71;

    PRAGMA foreign_keys=on;

COMMIT;
