import pl.deesoft.kotlinrepro.db.Type1;
import java.time.ZonedDateTime;
import kotlin.Boolean;

BEGIN TRANSACTION;
    PRAGMA foreign_keys=off;


    CREATE TABLE table61(
        col147 TEXT NOT NULL PRIMARY KEY,
        id TEXT DEFAULT NULL,
        col126 TEXT DEFAULT NULL,
        col140 TEXT NOT NULL,
        col128 TEXT NOT NULL,
        col71 TEXT DEFAULT NULL,
        col141 TEXT DEFAULT NULL,
        col129 TEXT DEFAULT NULL,
        col72 TEXT DEFAULT NULL,
        col113 TEXT NOT NULL,
        col29 INTEGER AS Boolean NOT NULL,
        col2 TEXT AS Type1 DEFAULT NULL,
        col132 TEXT AS Type1 DEFAULT NULL,
        col70 TEXT AS ZonedDateTime DEFAULT NULL,
        col104 INTEGER DEFAULT NULL,
        col34 TEXT DEFAULT NULL,
        col170 TEXT DEFAULT NULL,
        col146 TEXT DEFAULT NULL,
        col44 TEXT AS Type1 NOT NULL,
        CONSTRAINT cstr17
            FOREIGN KEY (col140)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr16
            FOREIGN KEY (col128)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr15
            FOREIGN KEY (col71)
            REFERENCES table41(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION
    );

    CREATE INDEX idx110 ON table61(col140);
    CREATE INDEX idx109 ON table61(col128);
    CREATE INDEX idx107 ON table61(col71);

    CREATE TABLE table62(
        col147 TEXT NOT NULL,
        col94 INTEGER NOT NULL,
        col21 TEXT NOT NULL,
        col124 INTEGER NOT NULL,
        PRIMARY KEY (col147, col21),
        CONSTRAINT cstr20
            FOREIGN KEY (col147)
            REFERENCES table61(col147)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr4
            FOREIGN KEY (col21)
            REFERENCES table12(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION
    );

    CREATE INDEX idx108 ON table62(col147);


    CREATE VIEW IF NOT EXISTS view27 AS
        SELECT
            D.id,
            D.col126,
            D.col147,
            D.col113,
            D.col170,
            D.col29,
            D.col2,
            D.col132,
            D.col44,
            S.id AS col262,
            S.col101 AS col263,
            S.col103 AS col264,
            S.col171 AS col265,
            D.col141,
            R.id AS col253,
            R.col101 AS col254,
            R.col103 AS col255,
            R.col171 AS col256,
            D.col129,
            I.col101 AS col236,
            I.col103 AS col237,
            I.col171 AS col238,
            D.col72,
            D.col70,
            D.col104,
            D.col34,
            D.col146
        FROM
            table49 D
        JOIN table41 S ON S.id=D.col140
        JOIN table41 R ON R.id=D.col128
        LEFT JOIN table41 I ON I.id=D.col71;

    CREATE VIEW IF NOT EXISTS view28 AS
        SELECT
            D.id,
            D.col126,
            D.col147,
            D.col113,
            D.col170,
            D.col29,
            D.col2,
            D.col132,
            D.col44,
            S.id AS col262,
            S.col101 AS col263,
            S.col103 AS col264,
            S.col171 AS col265,
            D.col141,
            R.id AS col253,
            R.col101 AS col254,
            R.col103 AS col255,
            R.col171 AS col256,
            D.col129,
            I.col101 AS col236,
            I.col103 AS col237,
            I.col171 AS col238,
            D.col72,
            D.col70,
            D.col104,
            D.col34,
            D.col146
        FROM
            table61 D
        JOIN table41 S ON S.id=D.col140
        JOIN table41 R ON R.id=D.col128
        LEFT JOIN table41 I ON I.id=D.col71;


    DROP VIEW IF EXISTS view25;

    CREATE VIEW view25 AS
       SELECT * FROM view27
       UNION ALL
       SELECT * FROM view28;


    DROP VIEW IF EXISTS view17;

    CREATE VIEW IF NOT EXISTS view18 AS
        SELECT
            D.col143,
            D.col94,
            P.col28,
            D.col124
            FROM table50 D
            LEFT JOIN table12 P ON P.id = D.col21;


    CREATE VIEW IF NOT EXISTS view19 AS
        SELECT
            D.col147,
            D.col94,
            P.col28,
            D.col124
            FROM table62 D
            LEFT JOIN table12 P ON P.id = D.col21;

    PRAGMA foreign_keys=on;
COMMIT;
