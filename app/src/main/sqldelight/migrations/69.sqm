CREATE TABLE table20 (
    id TEXT NOT NULL PRIMARY KEY,
    col101 TEXT NOT NULL,
    col88 TEXT NOT NULL,
    col103 INTEGER NOT NULL,
    col30 TEXT DEFAULT NULL,
    col162 TEXT DEFAULT NULL,
    col123 TEXT DEFAULT NULL,
    col131 TEXT DEFAULT NULL,
    col168 TEXT DEFAULT NULL,
    col167 INTEGER NOT NULL,
    CONSTRAINT cstr26 FOREIGN KEY (col167)
        REFERENCES table60(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION
);

INSERT INTO table20 (
    id,
    col101,
    col88,
    col103,
    col30,
    col162,
    col123,
    col131,
    col168,
    col167
)
SELECT
    id,
    col101,
    col88,
    col103,
    col30,
    col162,
    col123,
    col131,
    col168,
    COALESCE(
            (SELECT id FROM table60 WHERE table60.col85 = table19.table60),
            100000000240
        ) AS col167
FROM table19;

DROP INDEX IF EXISTS idx37;
DROP TABLE table19;
ALTER TABLE table20 RENAME TO table19;
CREATE INDEX idx37 ON table19(id);

CREATE VIEW IF NOT EXISTS view37 AS
    SELECT
        s.id,
        s.col101,
        s.col103,
        s.col167,
        s.col123,
        s.col131,
        es.col150,
        es.col78,
        s.col30
    FROM table19 s
    JOIN table54 es ON s.id=es.col24
    WHERE col7 = 1;


CREATE VIEW view12 AS
    SELECT
        I.id,
        I.col101,
        I.col103,
        I.col26,
        I.col62,
        I.col152,
        I.col155 AS col154,
        T.col69 AS col171,
        T.col87 AS col275,
        S.col101 AS col206,
	    C.col272,
	    I.col148,
        ST.col149,
        ST.col93
    FROM table5 I
    INNER JOIN table10 T ON I.col172=T.id
    INNER JOIN table19 S ON I.col24=S.id
    INNER JOIN table9 ST ON I.col155=ST.id
    LEFT JOIN view6 C ON I.id=C.col15;

CREATE VIEW IF NOT EXISTS view14 AS
    SELECT
        I.id,
        I.col101,
        I.col103,
        I.col152,
        I.col155 AS col266,
        col192.col87 AS col275,
        col192.col69 AS col274,
        B.col101 AS col207,
        I.col153,
        I.col26,
        I.col62,
        col190.col149,
        col190.col125,
        col190.col93
    FROM table5 I
    INNER JOIN table10 col192 ON I.col172=col192.id
    INNER JOIN table9 col190 ON I.col155=col190.id
    LEFT JOIN table19 B ON I.col24=B.id;

CREATE VIEW view5 AS
    SELECT
        S.id AS col24,
        S.col160 AS col160,
        S.col162,
        S.col269,
        S.col101 AS col101,
        S.col103 AS col103,
        S.col123 AS col123,
        S.col150 AS col150,
        S.col78 AS col78,
        S.col30 AS col30,
            (SELECT COALESCE(COUNT(I.id), 0) FROM table5 I WHERE I.col24=S.id AND I.col155 IN ('VAL121', 'VAL201', 'VAL122', 'VAL68', 'VAL1', 'VAL14', 'VAL17')) AS col194,
            (SELECT TOTAL(EC.table23) FROM table24 EC WHERE EC.col24=S.id) AS col222
    FROM view26 S
    WHERE col7 = 1
    ORDER BY S.col160 ASC, S.col103 ASC, col222 DESC;

CREATE VIEW IF NOT EXISTS view26 AS
    SELECT
       S.id,
       S.col88,
       S.col103,
       S.col101,
       S.col30,
       ES.col7,
       ES.col160,
       S.col162,
       col189.col162 AS col269,
       ES.col150,
       ES.col123,
       ES.col78
    FROM
        table19 S
    JOIN table54 ES ON S.id=ES.col24
    LEFT JOIN table58 col189 ON col189.col24=S.id;

CREATE VIEW IF NOT EXISTS view1 AS
    SELECT
        mo.id,
        mo.col106,
        mo.col124,
        mo.col27,
        mo.col45,
        mo.col38,
        mo.col173,
        mo.col39,
        p.col36,
        p.col28 AS col203,
        s.col103 AS col208,
        s.col101 AS col207,
        p.col5
    FROM table1 mo
    JOIN table19 s ON mo.col24 = s.id
    JOIN table12 p ON mo.col21 = p.id;

CREATE VIEW IF NOT EXISTS view2 AS
    SELECT
        mo.id,
        mo.col106,
        mo.col124,
        mo.col27,
        mo.col45,
        mo.col38,
        mo.col173,
        mo.col39,
        mo.col31,
        p.col36,
        p.id AS col21,
        p.col28 AS col203,
        p.col87 AS col202,
        mc.col87 AS col231,
        c.col87 AS col267,
        mo.col24 AS col24,
        s.col103 AS col208,
        s.col101 AS col207,
        u.col87 AS col226,
        u.col69 AS col225,
        p.col25,
        ps.col87 AS col216
    FROM table1 mo
    JOIN table19 s ON mo.col24 = s.id
    JOIN table12 p ON mo.col21 = p.id
    LEFT JOIN table14 u ON p.col64 = u.id
    LEFT JOIN table57 c ON p.col158 = c.id
    LEFT JOIN table36 mc ON c.col65 = mc.id
    LEFT JOIN table13 ps ON p.col46 = ps.id;

CREATE VIEW IF NOT EXISTS view40 AS
    SELECT
        s.id,
        s.col101,
        s.col103,
        es.col150,
        es.col78,
        s.col30,
        es.col160
    FROM table19 s
    JOIN table54 es ON s.id=es.col24
    WHERE col7 = 1;

CREATE VIEW IF NOT EXISTS view29 AS
    SELECT
        W.id,
        W.col124,
        W.col31,
        W.col37,
        W.col98,
        W.col132,
        S.col101 AS col207,
        S.col103 AS col208,
        S.col78 AS col78,
        R.col87 AS col247,
        R.col47 AS col245,
        R.col69 AS col246,
        P.col28 AS col203,
        MC.col87 AS col231,
        P.col36 AS col36,
        S.col150 AS col150
    FROM table63 W
    LEFT JOIN view40 S ON W.col24=S.id
    LEFT JOIN table12 P ON P.id = W.col21
    LEFT JOIN table36 MC ON P.col65=MC.id
    LEFT JOIN table40 R ON W.col100=R.id;

CREATE VIEW IF NOT EXISTS view38 AS
    SELECT
        IR.id AS col257,
        IR.col15 AS id,
        I.col101,
        I.col103,
        I.col26,
        I.col62,
        I.col152,
        T.col69 AS col171,
        S.col101 AS col206,
        S.col103 AS col208,
        IR.col124,
        IR.col21,
        P.col36,
        P.col28 AS col203,
        P.col65,
        MC.col87 AS col231,
        P.col158,
        C.col87 AS col267
    FROM table6 IR
    INNER JOIN table5 I ON IR.col15 = I.id
    INNER JOIN table10 T ON I.col172 = T.id
    INNER JOIN table19 S ON I.col24 = S.id
    LEFT JOIN table12 P ON P.id = IR.col21
    LEFT JOIN table57 C ON P.col158 = C.id
    LEFT JOIN table36 MC ON P.col65 = MC.id
    WHERE T.col69 = 'VAL15';

COMMIT;
PRAGMA foreign_keys=on;
