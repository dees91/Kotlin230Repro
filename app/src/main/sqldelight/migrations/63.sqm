PRAGMA foreign_keys=off;

BEGIN TRANSACTION;

    DROP INDEX idx16;
    DROP INDEX idx106;
    DROP INDEX idx36;

    CREATE TABLE table11(
        id TEXT NOT NULL UNIQUE PRIMARY KEY,
        col101 TEXT NOT NULL,
        col155 TEXT AS Type2 NOT NULL DEFAULT "VAL16",
        col172 INTEGER NOT NULL,
        col103 TEXT NOT NULL,
        col24 TEXT NOT NULL,
        col152 TEXT AS ZonedDateTime DEFAULT NULL,
        col62 TEXT AS Type1 DEFAULT NULL,
        col26 TEXT AS Type1 DEFAULT NULL,
        col153 TEXT AS Type1 DEFAULT NULL,
        col148 INTEGER DEFAULT 0 NOT NULL,
        CONSTRAINT cstr21
            FOREIGN KEY (col155)
            REFERENCES table9(id)
            ON DELETE SET DEFAULT
            ON UPDATE NO ACTION,
        CONSTRAINT cstr7
            FOREIGN KEY (col24)
            REFERENCES table19(id)
            ON DELETE CASCADE
            ON UPDATE NO ACTION,
        CONSTRAINT cstr27
            FOREIGN KEY (col172)
            REFERENCES table10(id)
            ON DELETE NO ACTION
            ON UPDATE NO ACTION
    );

    INSERT INTO table11(id, col101, col155, col172, col103, col24, col152, col62, col26, col153, col148)
    SELECT id, col101, col155, col172, col103, col24, col152, col62, col26, col153, col148 FROM table5;

    DROP INDEX idx46;
    DROP INDEX idx45;
    DROP INDEX idx47;
    DROP INDEX idx51;

    CREATE TABLE table25(
     id TEXT NOT NULL PRIMARY KEY,
     col18 TEXT NOT NULL,
     col22 TEXT NOT NULL,
     table23 INTEGER NOT NULL DEFAULT 0,
     col53 TEXT AS ZonedDateTime NOT NULL,
     col24 TEXT NOT NULL,
         CONSTRAINT cstr7
             FOREIGN KEY (col24)
             REFERENCES table19(id)
             ON DELETE CASCADE
             ON UPDATE NO ACTION,
         CONSTRAINT cstr3
             FOREIGN KEY (col18)
             REFERENCES table5(id)
             ON DELETE CASCADE
             ON UPDATE NO ACTION,
         CONSTRAINT cstr22
             FOREIGN KEY (col22)
             REFERENCES table57(id)
             ON DELETE NO ACTION
             ON UPDATE NO ACTION
     );

    INSERT INTO table25(id, col18, col22, table23, col53, col24)
    SELECT id, col18, col22, table23, col53, col24 FROM table24;

    DROP INDEX idx40;
    DROP INDEX idx39;
    DROP INDEX idx41;

    CREATE TABLE table26(
     id TEXT NOT NULL PRIMARY KEY,
     col22 TEXT NOT NULL,
     table23 INTEGER NOT NULL DEFAULT 0,
     col174 TEXT AS ZonedDateTime NOT NULL,
     col24 TEXT NOT NULL,
         CONSTRAINT cstr7
             FOREIGN KEY (col24)
             REFERENCES table19(id)
             ON DELETE CASCADE
             ON UPDATE NO ACTION,
         CONSTRAINT cstr22
             FOREIGN KEY (col22)
             REFERENCES table57(id)
             ON DELETE NO ACTION
             ON UPDATE NO ACTION
     );

    INSERT INTO table26(id, col22, table23, col174, col24)
    SELECT id, col22, table23, col174, col24 FROM table23;

    DROP TABLE table5;
    DROP TABLE table23;
    DROP TABLE table24;

    ALTER TABLE table11 RENAME TO table5;
    ALTER TABLE table26 RENAME TO table23;
    ALTER TABLE table25 RENAME TO table24;

    CREATE INDEX idx16 ON table5(id);
    CREATE INDEX idx106 ON table5(col172);
    CREATE INDEX idx36 ON table5(col24);

    CREATE INDEX idx46 ON table24(id);
    CREATE INDEX idx45 ON table24(col24);
    CREATE INDEX idx47 ON table24(col22);
    CREATE INDEX idx51 ON table24(col18);

    CREATE INDEX idx40 ON table23(id);
    CREATE INDEX idx39 ON table23(col24);
    CREATE INDEX idx41 ON table23(col22);

COMMIT;

PRAGMA foreign_keys=on;
