query111:
SELECT * FROM view20 col185 WHERE
    col15 = :col15
    AND EXISTS (
        SELECT col182.id FROM table8 col182 WHERE
                    col182.col15 = :col15
                    AND col182.col65 = col185.col65
                LIMIT 1
    )
ORDER BY col268 ASC;

query173:
SELECT
    SG.col103 AS col268,
    SG.col87 AS col267,
    G.col87 AS col231,
    SUM(AE.col124) AS col124
FROM table6 AE
LEFT JOIN table57 SG ON AE.col158 = SG.id
LEFT JOIN table36 G ON SG.col65 = G.id
WHERE AE.col15 = :col15
    AND EXISTS (
        SELECT col182.id FROM table8 col182 WHERE
            col182.col15 = :col15
            AND col182.col65 = G.id
            LIMIT 1
    )
    AND NOT EXISTS (
        SELECT * FROM view20 col185 WHERE
            col185.col15 = :col15
            AND col185.col65 = G.id
            LIMIT 1
    )
GROUP BY AE.col158
ORDER BY SG.col103;

query139:
SELECT SUM(col51)
FROM table24
WHERE col18 = :col15
    AND EXISTS (
          SELECT col182.id FROM table8 col182 WHERE
              col182.col15 = :col15
              AND col22 IN (SELECT sg.id FROM table57 sg WHERE sg.col65 = col182.col65)
          LIMIT 1
     );

query197:
INSERT OR IGNORE INTO
    table6(id,col15,col21,col28,col158,col65,col83,col166,col136,col137,col124,col91,col68)
SELECT
    :id,
    :col15,
    B.id,
    B.col28,
    B.col158,
    B.col65,
    :col83,
    :col166,
    :col136,
    :col137,
    :col124,
    :col91,
    :col68
FROM
    table12 B
WHERE
    B.col83 = :col83
    AND EXISTS (
        SELECT col182.id FROM table8 col182 WHERE
            col182.col15 = :col15
            AND col182.col65 = B.col65
        LIMIT 1
    )
LIMIT 1;

query191:
INSERT OR REPLACE INTO
    table6(id,col15,col21,col28,col158,col65,col83,col166,col136,col137,col124,col91, col68)
SELECT
    :id,
    :col15,
    B.id,
    :col28,
    B.col158,
    B.col65,
    B.col83,
    :col166,
    :col136,
    :col137,
    :col124,
    :col91,
    :col68
FROM
    table12 B
WHERE
    B.col28 = :col28
    AND (EXISTS (
        SELECT col182.id FROM table8 col182 WHERE
            (col182.col15 = :col15
            AND col182.col65 = B.col65)
        LIMIT 1
    ) OR :col28 = 999999999)
LIMIT 1;

query23:
SELECT count(B.id) FROM view23 B
    LEFT JOIN table8 col182 ON col182.col158 = B.col158
WHERE col182.col15 = :col15 AND (B.col83 = :code OR B.col28 = :code);
