query12:
SELECT count(*)
FROM view32
WHERE
    :col261 IS NULL OR (
        SUBSTR(CAST((col28 + 1000000000) AS TEXT), 2, 9) LIKE '%'||:col261||'%'
        OR col87 LIKE '%'||:col261||'%'
        OR col83 LIKE '%'||:col261||'%'
        OR col231 LIKE '%'||:col261||'%'
        OR col267 LIKE '%'||:col261||'%'
        OR col216 LIKE '%'||:col261||'%'
    )
;

query143:
SELECT * FROM view32
WHERE
    :col261 IS NULL OR (
        SUBSTR(CAST((col28 + 1000000000) AS TEXT), 2, 9) LIKE '%'||:col261||'%'
        OR col87 LIKE '%'||:col261||'%'
        OR col83 LIKE '%'||:col261||'%'
        OR col231 LIKE '%'||:col261||'%'
        OR col267 LIKE '%'||:col261||'%'
        OR col216 LIKE '%'||:col261||'%'
    )
ORDER BY col28 ASC
LIMIT :limit OFFSET :offset;
