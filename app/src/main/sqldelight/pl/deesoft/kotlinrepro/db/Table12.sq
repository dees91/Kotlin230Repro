query115:
SELECT *
FROM view23
WHERE
    (:col65 IS NULL OR col65 = :col65)
    AND (:col158 IS NULL OR col158 = :col158)
    AND (:col103 IS NULL OR (SUBSTR(CAST((col28 + 1000000000) AS TEXT), 2, 9) LIKE '%'||:col103||'%'))
    AND col46 IN :col217
ORDER BY
    SUBSTR(CAST((col28 + 1000000000) AS TEXT), 8, 9) ASC, col28 ASC
;

