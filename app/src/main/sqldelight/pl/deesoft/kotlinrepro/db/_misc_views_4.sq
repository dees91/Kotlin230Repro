CREATE VIEW IF NOT EXISTS view27 AS
    SELECT
        S.id,
        S.col127,
        S.col147,
        S.col113,
        S.col170,
        S.col29,
        S.col2,
        S.col132,
        S.col44,
        col187.id AS col262,
        col187.col101 AS col263,
        col187.col103 AS col264,
        col187.col171 AS col265,
        S.col141,
        R.id AS col253,
        R.col101 AS col254,
        R.col103 AS col255,
        R.col171 AS col256,
        S.col129,
        I.col101 AS col236,
        I.col103 AS col237,
        I.col171 AS col238,
        S.col72,
        S.col70,
        S.col104,
        S.col34,
        S.col146
    FROM
        table49 S
    JOIN table41 col187 ON col187.id=S.col140
    JOIN table41 R ON R.id=S.col128
    LEFT JOIN table41 I ON I.id=S.col71;

CREATE VIEW IF NOT EXISTS view28 AS
    SELECT
        S.id,
        S.col127,
        S.col147,
        S.col113,
        S.col170,
        S.col29,
        S.col2,
        S.col132,
        S.col44,
        col187.id AS col262,
        col187.col101 AS col263,
        col187.col103 AS col264,
        col187.col171 AS col265,
        S.col141,
        R.id AS col253,
        R.col101 AS col254,
        R.col103 AS col255,
        R.col171 AS col256,
        S.col129,
        I.col101 AS col236,
        I.col103 AS col237,
        I.col171 AS col238,
        S.col72,
        S.col70,
        S.col104,
        S.col34,
        S.col146
    FROM
        table61 S
    JOIN table41 col187 ON col187.id=S.col140
    JOIN table41 R ON R.id=S.col128
    LEFT JOIN table41 I ON I.id=S.col71;

CREATE VIEW IF NOT EXISTS view25 AS
   SELECT * FROM view27
   UNION ALL
   SELECT * FROM view28;

CREATE VIEW IF NOT EXISTS view37 AS
    SELECT
        b.id,
        b.col101,
        b.col103,
        b.col167,
        b.col123,
        b.col131,
        sb.col150,
        sb.col78,
        b.col30
    FROM table19 b
    JOIN table54 sb ON b.id=sb.col24
    WHERE col7 = 1;

CREATE VIEW IF NOT EXISTS view18 AS
    SELECT
        S.col143,
        S.col94,
        B.col28,
        S.col124
        FROM table50 S
        LEFT JOIN table12 B ON B.id = S.col21;

CREATE VIEW IF NOT EXISTS view19 AS
    SELECT
        S.col147,
        S.col94,
        B.col28,
        S.col124
        FROM table62 S
        LEFT JOIN table12 B ON B.id = S.col21;
