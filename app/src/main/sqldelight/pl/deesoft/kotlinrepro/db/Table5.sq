query54:
SELECT *
FROM view5
WHERE col150 = :col150
AND (col30 IS NULL
    OR col30 > (
        SELECT date('now', '-' || COALESCE(col12, 90) || ' days')
        FROM table43
        )
    )
ORDER BY col103 ASC, col78 DESC;

query235:
    SELECT *
    FROM view5
    WHERE
        col150 = :col150
        AND (col30 IS NULL
            OR col30 > (
                SELECT date('now', '-' || COALESCE(col12, 90) || ' days')
                FROM table43
                )
            )
        AND (
            CAST(col103 AS TEXT) LIKE '%'||:query||'%' OR
            col101 LIKE '%'||:query||'%'
        )
    ORDER BY col103 ASC, col78 DESC;

query135:
    SELECT
        COALESCE((SELECT SUM(col124) FROM table6 WHERE col15 = A.id AND
        col158 NOT IN (SELECT col22 FROM table24 WHERE col24 = A.col24)),0) AS col124
    FROM table5 A
    WHERE A.id = :col15;


