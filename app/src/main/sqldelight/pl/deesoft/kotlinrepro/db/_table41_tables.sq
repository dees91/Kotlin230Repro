import kotlin.Boolean;

CREATE TABLE table41(
    id TEXT NOT NULL PRIMARY KEY,
    col103 INTEGER NOT NULL,
    col101 TEXT NOT NULL,
    col171 TEXT NOT NULL
);

CREATE INDEX idx91 ON table41(id);

CREATE TABLE table43 (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    col123 TEXT NOT NULL,
    col23 TEXT DEFAULT NULL,
    col35 TEXT DEFAULT NULL,
    col180 INTEGER DEFAULT NULL,
    col161 INTEGER DEFAULT NULL,
    col179 INTEGER DEFAULT NULL,
    col17 INTEGER DEFAULT NULL,
    col13 INTEGER DEFAULT NULL,
    col16 INTEGER DEFAULT NULL,
    col144 INTEGER DEFAULT NULL,
    col12 INTEGER DEFAULT NULL,
    col105 INTEGER DEFAULT NULL,
    col82 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col79 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col81 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col74 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col80 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col77 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col73 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col109 INTEGER DEFAULT 100,
    col75 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col76 INTEGER AS Boolean DEFAULT 0 NOT NULL,
    col156 INTEGER DEFAULT NULL,
    col157 INTEGER DEFAULT NULL,
    col181 INTEGER DEFAULT NULL,
    col60 INTEGER DEFAULT NULL,
    col57 INTEGER DEFAULT NULL,
    col58 INTEGER DEFAULT NULL,
    col56 INTEGER DEFAULT NULL,
    col59 INTEGER DEFAULT NULL,
    col110 INTEGER DEFAULT NULL,
    col111 INTEGER DEFAULT NULL,
    CONSTRAINT cstr14
        FOREIGN KEY (col123)
        REFERENCES table41(id)
        ON DELETE CASCADE
);

CREATE INDEX idx90 ON table43(id);
CREATE UNIQUE INDEX idx112 ON table43(col123);

CREATE TABLE table42 (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    col123 TEXT NOT NULL,
    col24 TEXT NOT NULL,
    col179 INTEGER DEFAULT NULL,
    col17 INTEGER DEFAULT NULL,
    col181 INTEGER DEFAULT NULL,
    UNIQUE(col123,col24),
    CONSTRAINT cstr14
        FOREIGN KEY (col123)
        REFERENCES table41(id)
        ON DELETE CASCADE,
    CONSTRAINT cstr6
        FOREIGN KEY (col24)
        REFERENCES table19(id)
        ON DELETE CASCADE
);

CREATE INDEX idx89 ON table42(id);
