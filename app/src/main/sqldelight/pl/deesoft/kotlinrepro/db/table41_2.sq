query285:
INSERT INTO table42(
    col123,
    col24,
    col181,
    col179,
    col17
)
VALUES (
    :col123,
    :col24,
    :col181,
    :col179,
    :col17
)
ON CONFLICT(col123, col24) DO UPDATE SET
    col181 = excluded.col181,
    col179 = excluded.col179,
    col17 = excluded.col17;
