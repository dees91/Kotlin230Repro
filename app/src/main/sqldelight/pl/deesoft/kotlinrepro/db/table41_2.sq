query287:
INSERT INTO table41(id, col101, col171, col103)
VALUES (:id, :col101, :col171, :col103)
ON CONFLICT(id) DO UPDATE SET
    col103 = excluded.col103,
    col101 = excluded.col101,
    col171 = excluded.col171;

