query206:
INSERT OR IGNORE INTO table6(
    id,
    col166,
    col15,
    col21,
    col158,
    col65,
    col28,
    col83,
    col136,
    col137,
    col124,
    col108,
    col91
) SELECT
    :id,
    :col166,
    :col15,
    :col21,
    B.col158,
    B.col65,
    B.col28,
    B.col83,
    :col136,
    :col137,
    :col124,
    :col108,
    :col91
FROM table12 B WHERE B.id=:col21 LIMIT 1;
