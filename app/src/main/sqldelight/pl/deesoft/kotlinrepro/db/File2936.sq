query181:
SELECT
    CASE
        WHEN
            (SELECT col181 FROM table42 WHERE col24 = :col24) IS NOT NULL
        THEN
            (SELECT col181 FROM table42 WHERE col24 = :col24)

        WHEN
            (SELECT col181 FROM table43) IS NOT NULL
        THEN
            (SELECT col181 FROM table43)

        ELSE
            NULL
    END value
FROM table43;

