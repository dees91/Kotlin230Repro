import pl.deesoft.kotlinrepro.db.Type1;
import pl.deesoft.kotlinrepro.db.Type2;
import pl.deesoft.kotlinrepro.db.Type3;
import kotlin.Boolean;
import java.time.ZonedDateTime;


CREATE TABLE table10(
    id INTEGER NOT NULL PRIMARY KEY,
    col69 TEXT AS Type3 NOT NULL,
    col87 TEXT NOT NULL,
    col7 INTEGER AS Boolean NOT NULL DEFAULT 1,
    col139 INTEGER AS Boolean NOT NULL DEFAULT 1
);

CREATE INDEX idx23 ON table10(id);


CREATE TABLE table9(
    id TEXT AS Type2 NOT NULL PRIMARY KEY,
    col125 INTEGER AS Boolean NOT NULL DEFAULT 0,
    col93 INTEGER AS Boolean NOT NULL DEFAULT 0,
    col149 INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx22 ON table9(id);

INSERT OR IGNORE INTO table9(id,col125,col93,col149) VALUES
    ('VAL1',0,0,0),
    ('VAL14',1,0,10000),
    ('VAL17',1,0,10000),
    ('VAL13',1,0,20000),
