CREATE TABLE table5(
    id TEXT NOT NULL UNIQUE PRIMARY KEY,
    col101 TEXT NOT NULL,
    col155 TEXT AS Type2 NOT NULL DEFAULT "VAL16",
    col172 INTEGER NOT NULL,
    col103 TEXT NOT NULL,
    col24 TEXT NOT NULL,
    col152 TEXT AS ZonedDateTime DEFAULT NULL,
    col62 TEXT AS Type1 DEFAULT NULL,
    col26 TEXT AS Type1 DEFAULT NULL,
    col153 TEXT AS Type1 DEFAULT NULL,
    col148 INTEGER DEFAULT 0 NOT NULL,
    CONSTRAINT cstr21
        FOREIGN KEY (col155)
        REFERENCES table9(id)
        ON DELETE SET DEFAULT
        ON UPDATE NO ACTION,
    CONSTRAINT cstr7
        FOREIGN KEY (col24)
        REFERENCES table19(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,
    CONSTRAINT cstr27
        FOREIGN KEY (col172)
        REFERENCES table10(id)
        ON DELETE NO ACTION
        ON UPDATE NO ACTION
);

CREATE INDEX idx16 ON table5(id);
CREATE INDEX idx106 ON table5(col172);
CREATE INDEX idx36 ON table5(col24);

CREATE TABLE table8(
    id TEXT NOT NULL UNIQUE PRIMARY KEY,
    col15 TEXT NOT NULL,
    col65 TEXT DEFAULT NULL,
    col158 TEXT DEFAULT NULL,
    col21 TEXT DEFAULT NULL,
    UNIQUE (col15, col65, col158, col21),
    CHECK(
        (col65 IS NOT NULL AND col158 IS NULL AND col21 IS NULL)
        OR (col65 IS NULL AND col158 IS NOT NULL AND col21 IS NULL)
        OR (col65 IS NULL AND col158 IS NULL AND col21 IS NOT NULL)
    ),
    CONSTRAINT cstr2
        FOREIGN KEY (col15)
        REFERENCES table5(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT cstr11
        FOREIGN KEY (col65)
        REFERENCES table36(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT cstr22
        FOREIGN KEY (col158)
        REFERENCES table57(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT cstr4
        FOREIGN KEY (col21)
        REFERENCES table12(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE INDEX idx20 ON table8(id);
CREATE INDEX idx17 ON table8(col15);
CREATE INDEX idx19 ON table8(col65);
CREATE INDEX idx21 ON table8(col158);
CREATE INDEX idx18 ON table8(col21);

CREATE TABLE table24(
 id TEXT NOT NULL PRIMARY KEY,
 col18 TEXT NOT NULL,
 col22 TEXT NOT NULL,
 col51 INTEGER NOT NULL DEFAULT 0,
 col52 TEXT AS ZonedDateTime NOT NULL,
 col24 TEXT NOT NULL,
     CONSTRAINT cstr7
         FOREIGN KEY (col24)
         REFERENCES table19(id)
         ON DELETE CASCADE
         ON UPDATE NO ACTION,
     CONSTRAINT cstr3
         FOREIGN KEY (col18)
         REFERENCES table5(id)
         ON DELETE CASCADE
         ON UPDATE NO ACTION,
     CONSTRAINT cstr22
         FOREIGN KEY (col22)
         REFERENCES table57(id)
         ON DELETE NO ACTION
         ON UPDATE NO ACTION
 );

CREATE INDEX idx46 ON table24(id);
CREATE INDEX idx45 ON table24(col24);
CREATE INDEX idx47 ON table24(col22);
CREATE INDEX idx51 ON table24(col18);

CREATE TABLE table23(
 id TEXT NOT NULL PRIMARY KEY,
 col22 TEXT NOT NULL,
 col51 INTEGER NOT NULL DEFAULT 0,
 col174 TEXT AS ZonedDateTime NOT NULL,
 col24 TEXT NOT NULL,
     CONSTRAINT cstr7
         FOREIGN KEY (col24)
         REFERENCES table19(id)
         ON DELETE CASCADE
         ON UPDATE NO ACTION,
     CONSTRAINT cstr22
         FOREIGN KEY (col22)
         REFERENCES table57(id)
         ON DELETE NO ACTION
         ON UPDATE NO ACTION
 );

CREATE INDEX idx40 ON table23(id);
CREATE INDEX idx39 ON table23(col24);
CREATE INDEX idx41 ON table23(col22);
